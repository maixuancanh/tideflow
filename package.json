  },
  "dependencies": {
    "@babylonjs/core": "^9.0.0",
    "@babylonjs/loaders": "^9.27.1",
    "@babylonjs/materials": "^9.0.0",
    "earcut": "^3.0.0"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
